---
// Film-slate chapter break, Upendra style: the striped clapboard arm
// swings open as you scroll past. "CUT — next scene."
interface Props {
  scene?: string;
  title?: string;
  note?: string;
}
const { scene = '03', title = 'THE PROCESS', note = 'CUT — next scene' } = Astro.props;
---

<div class="bg-cream py-2">
  <div data-slate class="max-w-4xl mx-auto px-5 md:px-8" style="perspective: 900px;">
    <div class="bg-ink text-cream rounded-2xl overflow-hidden border border-ink/20 shadow-[0_16px_50px_rgba(28,25,23,0.18)]">
      <!-- clapboard arm: striped stick that swings open on scroll -->
      <div data-slate-arm class="origin-top" style="transform-origin: top center;">
        <div class="h-6" style="background: repeating-linear-gradient(-55deg, #FAF7F2 0 18px, #1C1917 18px 36px);"></div>
        <div class="flex items-center justify-between px-5 md:px-7 py-3 border-b border-cream/15">
          <p class="font-display text-lg md:text-2xl tracking-tight">SCENE {scene} <span class="text-ember">·</span> {title}</p>
          <p class="text-[11px] font-bold uppercase tracking-widest2 text-cream/60">Take 01</p>
        </div>
      </div>
      <div class="flex items-center justify-between px-5 md:px-7 py-2.5 text-[11px] font-bold uppercase tracking-widest2">
        <span class="text-ember">{note} ↓</span>
        <span class="text-cream/50">VJS Studios presents</span>
      </div>
    </div>
  </div>
</div>
