---
import SectionHeading from './SectionHeading.astro';
import { STATS } from '../data/content';
---

<section id="story" class="py-20 md:py-32 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <SectionHeading eyebrow="Chapter 01 — Our story" title="We built furniture for 18 years. Now we build the whole room around it." desc="Most studios outsource. We never had to — our factory was already cutting, pressing and polishing. Opening VJS Studios meant one team now owns your design, build and installation." />

    <div class="mt-12 grid md:grid-cols-2 gap-6 md:gap-10 items-start">
      <div class="relative rounded-3xl overflow-hidden min-h-[420px] md:min-h-[560px] split-sticky" data-reveal>
        <img data-parallax data-speed="slow" src="https://images.unsplash.com/photo-1565043666747-69f6646db940?q=80&w=1400&auto=format&fit=crop" alt="VJS furniture factory floor" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/50 via-transparent to-transparent pointer-events-none"></div>
        <div class="absolute bottom-4 left-4 right-4 bg-cream/90 backdrop-blur rounded-2xl p-5 flex items-center gap-4" data-speed="fast">
          <span class="w-12 h-12 rounded-xl bg-ember text-cream grid place-items-center text-xl">◈</span>
          <div>
            <p class="font-bold text-sm">Visit the factory before you book</p>
            <p class="text-sm text-smoke">See panel cutting, edge-banding & QC live.</p>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-5">
        {[
          { t: 'Then — trusted by carpenters & builders', d: 'Our factory supplied precision-cut kitchens, wardrobes and office furniture across Karnataka. Laser measurements, BWP plywood, soft-close hardware as standard.' },
          { t: 'The gap we kept seeing', d: 'Beautiful modules, broken experience — designs that ignored light, civil delays, outsourced finishing. Clients asked: why don’t YOU do the whole home?' },
          { t: 'Now — VJS Studios', d: 'A Bangalore design studio on top of a working factory. You get 3D designs, fixed quotes, in-house manufacturing, dust-controlled installation and a written 10-year warranty.' },
        ].map((s, i) => (
          <div class="bg-white rounded-3xl p-7 border border-ink/8 shadow-[0_10px_40px_rgba(28,25,23,0.06)]" data-reveal data-delay={String(i * 0.08)}>
            <p class="text-[11px] font-bold uppercase tracking-widest2 text-wood mb-2">0{i + 1}</p>
            <h3 class="font-display text-xl md:text-2xl mb-2">{s.t}</h3>
            <p class="text-smoke leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4">
      {STATS.map((s) => (
        <div class="bg-sand rounded-2xl p-6 text-center" data-reveal>
          <p class="font-display text-3xl md:text-4xl"><span data-count={s.value}>0</span><span class="text-wood">{s.suffix}</span></p>
          <p class="text-sm text-smoke mt-1 font-semibold">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
