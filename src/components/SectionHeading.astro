---
interface Props { eyebrow: string; title: string; desc?: string; align?: 'left' | 'center'; dark?: boolean }
const { eyebrow, title, desc, align = 'left', dark = false } = Astro.props;
---

<div class={align === 'center' ? 'text-center max-w-2xl mx-auto' : 'max-w-2xl'} data-reveal>
  <p class={`text-[11px] font-bold uppercase tracking-widest2 mb-3 ${dark ? 'text-brass' : 'text-wood'}`}>{eyebrow}</p>
  <h2 class={`font-display text-3xl md:text-5xl leading-[1.05] tracking-tight ${dark ? 'text-cream' : 'text-ink'}`}>{title}</h2>
  {desc && <p class={`mt-4 text-base md:text-lg leading-relaxed ${dark ? 'text-cream/70' : 'text-smoke'}`}>{desc}</p>}
</div>
