---
// Plank-flip divider: a plywood plank showing its raw back first,
// flipping to the polished veneer face as you scroll.
// Bridges the dark Process chapter into the light About chapter.
---

<div class="bg-ink pb-4 -mb-1" style="perspective: 1200px;">
  <div class="max-w-4xl mx-auto px-5 md:px-8 py-8">
    <div data-plank class="relative h-28 md:h-32" style="transform-style: preserve-3d;">
      <!-- raw back -->
      <div class="absolute inset-0 rounded-2xl grid place-items-center border border-ember/50 bg-[#33241a] px-4 text-center" style="backface-visibility: hidden;">
        <p class="text-[11px] md:text-xs font-bold uppercase tracking-wide md:tracking-widest2 text-cream/70 leading-relaxed">Raw side · 18mm BWP ply ·<br class="sm:hidden" /> zero polish</p>
      </div>
      <!-- polished face -->
      <div class="absolute inset-0 rounded-2xl grid place-items-center border border-ink/10 bg-linen px-4 text-center" style="transform: rotateX(180deg); backface-visibility: hidden;">
        <p class="text-[11px] md:text-xs font-bold uppercase tracking-wide md:tracking-widest2 text-ink leading-relaxed">Polished side · studio veneer ·<br class="sm:hidden" /> ready for home <span class="text-ember">✦</span></p>
      </div>
    </div>
    <p class="text-center text-cream/40 text-[11px] font-bold uppercase tracking-widest2 mt-3">scroll — flipping the plank</p>
  </div>
</div>
