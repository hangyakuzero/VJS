---
import { SITE } from '../data/content';
---

<section id="top" class="relative min-h-screen flex items-end overflow-hidden pt-[72px]">
  <div class="absolute inset-0" data-speed="slow" data-hero-bg>
    <img id="hero-img" src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=2000&auto=format&fit=crop" alt="Warm minimal living room designed by VJS Studios" class="w-full h-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/35 to-ink/20"></div>
  </div>
  <!-- floating ember depth orb (slow layer) -->
  <div class="absolute -top-20 -right-20 w-[420px] h-[420px] rounded-full bg-ember/25 blur-[120px] pointer-events-none" data-speed="slow" aria-hidden="true"></div>
  <div class="absolute top-1/3 -left-32 w-[320px] h-[320px] rounded-full bg-brass/20 blur-[100px] pointer-events-none" data-speed="mid" aria-hidden="true"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-8 pb-14 md:pb-20 pt-24 w-full text-cream" data-hero-content>
    <div class="flex items-center gap-3 mb-5" data-hero-line>
      <span class="text-[11px] font-bold uppercase tracking-widest2 bg-cream/15 backdrop-blur px-4 py-2 rounded-full border border-cream/20">● Bangalore · Factory + Studio</span>
    </div>
    <h1 class="font-display text-[13vw] sm:text-6xl md:text-8xl leading-[0.95] tracking-tight max-w-5xl">
      <span class="block overflow-hidden"><span class="block" data-hero-line>From our factory</span></span>
      <span class="block overflow-hidden"><span class="block italic font-normal text-linen" data-hero-line>to your home.</span></span>
    </h1>
    <div class="mt-6 flex flex-col md:flex-row md:items-end gap-6 md:gap-12">
      <p class="max-w-xl text-cream/80 text-base md:text-lg leading-relaxed" data-hero-line>
        VJS Studios is Bangalore’s factory-direct interior studio — 18 years manufacturing furniture,
        now designing full homes, kitchens, wardrobes & commercial spaces. Scroll to see how it’s made.
      </p>
      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3" data-hero-line>
        <a href="#book" class="bg-cream text-ink font-bold px-7 py-3.5 rounded-full hover:bg-wood hover:text-cream active:bg-wood active:text-cream transition-colors text-center">Book Consultation</a>
        <a href="#story" class="border border-cream/40 font-bold px-7 py-3.5 rounded-full hover:bg-cream/10 active:bg-cream/10 transition-colors text-center">↓ Explore our story</a>
      </div>
    </div>
    <div class="mt-10 grid grid-cols-3 max-w-lg gap-6 text-sm border-t border-cream/20 pt-6" data-hero-line>
      <div><p class="font-display text-2xl md:text-3xl">18+</p><p class="text-cream/60">yrs factory</p></div>
      <div><p class="font-display text-2xl md:text-3xl">1,200+</p><p class="text-cream/60">homes done</p></div>
      <div><p class="font-display text-2xl md:text-3xl">10-yr</p><p class="text-cream/60">warranty</p></div>
    </div>
  </div>
</section>
