---
---

<section id="top" class="relative min-h-[100svh] flex flex-col justify-end overflow-hidden bg-graphite text-chalk pt-[72px]">
  <!-- immersive frames -->
  <div class="absolute inset-0" data-hero-bg>
    <img id="hero-img-living" src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=2400&auto=format&fit=crop" alt="Considered living room with warm minimal palette" class="hero-frame absolute inset-0 w-full h-full object-cover opacity-100" fetchpriority="high" />
    <img id="hero-img-working" src="https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=2400&auto=format&fit=crop" alt="Considered workspace with daylight and timber" class="hero-frame absolute inset-0 w-full h-full object-cover opacity-0 scale-[1.04]" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-graphite via-graphite/35 to-graphite/10"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-graphite/50 via-transparent to-transparent"></div>
  </div>

  <!-- top gallery bar -->
  <div class="absolute top-[72px] inset-x-0 z-10">
    <div class="max-w-[1400px] mx-auto px-5 md:px-10 pt-6 flex items-center justify-between text-[11px] font-bold uppercase tracking-[0.22em] text-chalk/70">
      <span class="hidden sm:flex items-center gap-3"><span class="w-10 h-px bg-bronze/70 inline-block"></span> N°01 — The Opening Room</span>
      <span class="sm:hidden">N°01</span>
      <span class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="hero-availability">Booking Nov — Jan projects</span>
      </span>
    </div>
  </div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-5 md:px-10 pb-8 md:pb-12 pt-28 w-full" data-hero-content>
    <!-- Living / Working selector -->
    <div class="flex items-center gap-3 mb-6" data-hero-line>
      <div class="inline-flex p-1 rounded-full bg-chalk/10 backdrop-blur-md border border-chalk/15" role="tablist" aria-label="Explore spaces">
        <button id="tab-living" role="tab" aria-selected="true" class="px-5 py-2.5 rounded-full text-[12px] font-bold uppercase tracking-[0.14em] bg-chalk text-graphite transition-all">Living</button>
        <button id="tab-working" role="tab" aria-selected="false" class="px-5 py-2.5 rounded-full text-[12px] font-bold uppercase tracking-[0.14em] text-chalk/70 hover:text-chalk transition-all">Working</button>
      </div>
      <span id="hero-mode-note" class="hidden md:block text-[12px] font-semibold uppercase tracking-[0.18em] text-chalk/50">Homes · 1,200+ delivered</span>
    </div>

    <h1 class="font-display font-medium text-[13.5vw] sm:text-7xl lg:text-[108px] leading-[0.92] tracking-tight display-tight max-w-6xl">
      <span class="block overflow-hidden"><span class="block" data-hero-line>Distinctive spaces.</span></span>
      <span class="block overflow-hidden"><span class="block italic font-normal text-chalk/90" data-hero-line id="hero-line-2">Designed around you.</span></span>
    </h1>

    <div class="mt-7 flex flex-col lg:flex-row lg:items-end gap-8 lg:gap-14">
      <p id="hero-copy" class="max-w-xl text-chalk/70 text-[15px] md:text-lg leading-relaxed" data-hero-line>
        VJS is a Bangalore design atelier — homes, kitchens and workspaces composed around light, ritual and material. Backed by our own factory for a precise, lasting build.
      </p>
      <div class="flex flex-col sm:flex-row gap-3" data-hero-line>
        <a href="#studies" class="bg-chalk text-graphite font-bold px-8 py-4 rounded-full hover:bg-bronze hover:text-chalk active:bg-bronze active:text-chalk transition-colors text-center text-sm uppercase tracking-[0.12em]">Explore the spaces</a>
        <a href="#book" class="border border-chalk/30 backdrop-blur font-bold px-8 py-4 rounded-full hover:bg-chalk/10 active:bg-chalk/10 transition-colors text-center text-sm uppercase tracking-[0.12em]">Discuss project →</a>
      </div>
    </div>

    <!-- gallery caption + stats -->
    <div class="mt-10 border-t border-chalk/15 pt-5 flex flex-col md:flex-row md:items-center gap-5 justify-between" data-hero-line>
      <p id="hero-caption" class="text-[12px] font-semibold uppercase tracking-[0.18em] text-chalk/55">Fig. 01 — Warm minimal living room · White oak, limewash, linen</p>
      <div class="grid grid-cols-3 gap-8 text-sm max-w-md w-full md:w-auto">
        <div><p class="font-display text-2xl md:text-[28px] leading-none">18<span class="text-bronze">+</span></p><p class="text-chalk/50 text-[11px] uppercase tracking-[0.14em] mt-1.5 font-bold">yrs craft</p></div>
        <div><p class="font-display text-2xl md:text-[28px] leading-none">1.2k<span class="text-bronze">+</span></p><p class="text-chalk/50 text-[11px] uppercase tracking-[0.14em] mt-1.5 font-bold">spaces</p></div>
        <div><p class="font-display text-2xl md:text-[28px] leading-none">10<span class="text-bronze">-yr</span></p><p class="text-chalk/50 text-[11px] uppercase tracking-[0.14em] mt-1.5 font-bold">warranty</p></div>
      </div>
    </div>
  </div>

  <!-- scroll cue -->
  <div class="relative z-10 flex justify-center pb-5">
    <span class="w-6 h-10 rounded-full border border-chalk/25 flex justify-center pt-2"><span class="w-1 h-2 rounded-full bg-chalk/60 animate-bounce"></span></span>
  </div>
</section>

<script is:inline>
  (function(){
    const living = document.getElementById('hero-img-living');
    const working = document.getElementById('hero-img-working');
    const tabL = document.getElementById('tab-living');
    const tabW = document.getElementById('tab-working');
    const line2 = document.getElementById('hero-line-2');
    const copy = document.getElementById('hero-copy');
    const cap = document.getElementById('hero-caption');
    const note = document.getElementById('hero-mode-note');
    if(!living || !working || !tabL || !tabW) return;
    function setMode(mode){
      const isLiving = mode === 'living';
      living.style.opacity = isLiving ? '1' : '0';
      working.style.opacity = isLiving ? '0' : '1';
      living.style.transform = isLiving ? 'scale(1)' : 'scale(1.04)';
      working.style.transform = isLiving ? 'scale(1.04)' : 'scale(1)';
      tabL.setAttribute('aria-selected', String(isLiving));
      tabW.setAttribute('aria-selected', String(!isLiving));
      tabL.className = 'px-5 py-2.5 rounded-full text-[12px] font-bold uppercase tracking-[0.14em] transition-all ' + (isLiving ? 'bg-chalk text-graphite' : 'text-chalk/70 hover:text-chalk');
      tabW.className = 'px-5 py-2.5 rounded-full text-[12px] font-bold uppercase tracking-[0.14em] transition-all ' + (!isLiving ? 'bg-chalk text-graphite' : 'text-chalk/70 hover:text-chalk');
      if(line2) line2.textContent = isLiving ? 'Designed around you.' : 'Designed for how you work.';
      if(copy) copy.textContent = isLiving
        ? 'VJS is a Bangalore design atelier — homes, kitchens and wardrobes composed around light, ritual and material. Backed by our own factory for a precise, lasting build.'
        : 'VJS designs workspaces that open fast and photograph well — offices, clinics, retail and studios. One team from concept to handover in 30–60 days.';
      if(cap) cap.textContent = isLiving
        ? 'Fig. 01 — Warm minimal living room · White oak, limewash, linen'
        : 'Fig. 02 — Daylight workspace · Ash timber, fluted glass, bronze';
      if(note) note.textContent = isLiving ? 'Homes · 1,200+ delivered' : 'Workspaces · 30–60 day fit-outs';
    }
    tabL.addEventListener('click', () => setMode('living'));
    tabW.addEventListener('click', () => setMode('working'));
  })();
</script>
