---
import SectionHeading from './SectionHeading.astro';
---

<section id="about" class="py-20 md:py-32 bg-paper/60 border-y border-ink/8 scroll-mt-20">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
    <div class="lg:sticky lg:top-24">
      <SectionHeading eyebrow="The studio" title="We design from how you live, not how it photographs." desc="VJS began as a furniture factory in 2007. The atelier exists so you buy once — designer judgement, manufacturer honesty, one accountable team." />
      <div class="mt-8 grid grid-cols-2 gap-4" data-reveal>
        <div class="rounded-2xl bg-chalk border border-ink/10 p-5">
          <p class="font-display text-3xl">21<span class="text-bronze">-pt</span></p>
          <p class="text-[12px] font-bold uppercase tracking-[0.14em] text-stone mt-1">factory QC check</p>
        </div>
        <div class="rounded-2xl bg-chalk border border-ink/10 p-5">
          <p class="font-display text-3xl">45<span class="text-bronze">–60</span></p>
          <p class="text-[12px] font-bold uppercase tracking-[0.14em] text-stone mt-1">days design → handover</p>
        </div>
      </div>
      <div class="mt-6 flex flex-wrap gap-3" data-reveal>
        <a href="#book" class="bg-graphite text-chalk text-[12px] font-bold uppercase tracking-[0.12em] px-7 py-4 rounded-full hover:bg-aubergine transition-colors">Book consultation</a>
        <a href="#studies" class="border border-ink/15 text-[12px] font-bold uppercase tracking-[0.12em] px-7 py-4 rounded-full hover:bg-graphite hover:text-chalk transition-colors">See studies</a>
      </div>
    </div>
    <div class="flex flex-col gap-4">
      {[
        ['01 — Light first', 'We map morning to evening sun before a single wall moves. Sheers where glare hits, limewash where rooms run dark, task pools where hands work.', 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?q=80&w=1200&auto=format&fit=crop'],
        ['02 — Movement', 'Circulation is drawn like choreography — kitchen triangle, bedroom-to-bath at night, client flow in commercial. Nothing beautiful that trips you.', 'https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?q=80&w=1200&auto=format&fit=crop'],
        ['03 — Honest material', 'BWP plywood, real timber veneer, stone you can reseal. We show you cut edges and hardware in the factory before you commit.', 'https://images.unsplash.com/photo-1615873968403-89e068629265?q=80&w=1200&auto=format&fit=crop'],
        ['04 — Ritual', 'Pooja niches, filter corners, inverter nooks, maid storage — the Bangalore realities catalogues forget. Designed in, not patched after.', 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1200&auto=format&fit=crop'],
      ].map(([t, d, img], i) => (
        <article class="group rounded-[24px] overflow-hidden bg-chalk border border-ink/10 grid sm:grid-cols-[220px_1fr] lift" data-reveal>
          <div class="relative min-h-[180px] sm:min-h-full overflow-hidden">
            <img src={img} alt={t} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
          </div>
          <div class="p-6 md:p-8">
            <p class="g-label text-wood">{t}</p>
            <p class="mt-3 text-[15px] leading-relaxed text-ink/75">{d}</p>
            <p class="mt-4 text-[12px] font-bold text-stone">0{i + 1} / 04</p>
          </div>
        </article>
      ))}
      <div class="rounded-[24px] bg-graphite text-chalk p-7 md:p-8 flex items-center gap-5" data-reveal>
        <span class="w-12 h-12 rounded-full bg-bronze/20 grid place-items-center font-display text-xl shrink-0">✦</span>
        <p class="text-[14px] leading-relaxed text-chalk/75"><span class="text-chalk font-bold">Factory, not footnote.</span> Our own machines cut, edge and press every module — then our own crew installs it. One contract, daily photo updates, 10-year warranty in writing.</p>
      </div>
    </div>
  </div>
</section>
