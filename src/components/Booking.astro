---
import { SITE } from '../data/content';
---

<section id="book" class="py-20 md:py-32 bg-chalk scroll-mt-20">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10">
    <div class="rounded-[32px] overflow-hidden grid lg:grid-cols-[1fr_1.1fr] bg-graphite text-chalk border border-ink/10">
      <div class="relative p-8 md:p-14 flex flex-col justify-center overflow-hidden min-h-[420px]">
        <img src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=1400&auto=format&fit=crop" alt="" class="absolute inset-0 w-full h-full object-cover opacity-30" />
        <div class="absolute inset-0 bg-gradient-to-t from-graphite via-graphite/60 to-graphite/20"></div>
        <div class="relative" data-reveal>
          <p class="g-label text-bronze mb-4">Final chapter — Consultation</p>
          <h2 class="font-display font-medium text-3xl md:text-[48px] leading-[1.02] tracking-tight">Your home, considered. Let's talk this week.</h2>
          <p class="mt-4 text-chalk/65 leading-relaxed text-[15px]">Free site visit + measurement anywhere in Bangalore. Fixed quote in 48 hours. No advance until you approve the 3D design.</p>
          <p id="book-palette-note" class="hidden mt-5 inline-flex w-fit items-center gap-2 bg-bronze/15 border border-bronze/30 text-bronze text-[12px] font-bold uppercase tracking-[0.12em] px-4 py-2.5 rounded-full"></p>
          <ul class="mt-7 space-y-3 text-sm font-semibold">
            <li class="flex gap-3 items-center"><span class="w-9 h-9 rounded-full bg-chalk/10 grid place-items-center">✆</span>{SITE.phoneDisplay} · {SITE.hours}</li>
            <li class="flex gap-3 items-center"><span class="w-9 h-9 rounded-full bg-chalk/10 grid place-items-center">✉</span>{SITE.email}</li>
            <li class="flex gap-3 items-center"><span class="w-9 h-9 rounded-full bg-chalk/10 grid place-items-center">◉</span><span class="text-chalk/70 font-medium">{SITE.address}</span></li>
          </ul>
        </div>
      </div>
      <div class="bg-chalk text-ink p-8 md:p-14" data-reveal>
        <form id="book-form" class="flex flex-col gap-4">
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="flex flex-col gap-1.5 text-[12px] font-bold uppercase tracking-[0.12em] text-stone">Name
              <input required name="name" placeholder="Ananya Sharma" class="text-base font-medium normal-case tracking-normal bg-white border border-ink/10 rounded-xl px-4 py-3.5 outline-none focus:border-bronze placeholder:text-ink/30" />
            </label>
            <label class="flex flex-col gap-1.5 text-[12px] font-bold uppercase tracking-[0.12em] text-stone">Phone
              <input required name="phone" type="tel" pattern="[0-9+ ]{10,15}" placeholder="+91 ..." class="text-base font-medium bg-white border border-ink/10 rounded-xl px-4 py-3.5 outline-none focus:border-bronze placeholder:text-ink/30" />
            </label>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="flex flex-col gap-1.5 text-[12px] font-bold uppercase tracking-[0.12em] text-stone">Project
              <select name="service" class="text-base font-medium bg-white border border-ink/10 rounded-xl px-4 py-3.5 outline-none focus:border-bronze">
                <option>Full home interior</option>
                <option>Modular kitchen</option>
                <option>Wardrobes & storages</option>
                <option>Commercial space</option>
              </select>
            </label>
            <label class="flex flex-col gap-1.5 text-[12px] font-bold uppercase tracking-[0.12em] text-stone">Budget
              <select name="budget" class="text-base font-medium bg-white border border-ink/10 rounded-xl px-4 py-3.5 outline-none focus:border-bronze">
                <option>₹1.5–3L (single space)</option>
                <option>₹3–7L (kitchen / 1BHK)</option>
                <option selected>₹7–15L (2–3BHK)</option>
                <option>₹15L+ (villa / commercial)</option>
              </select>
            </label>
          </div>
          <label class="flex flex-col gap-1.5 text-[12px] font-bold uppercase tracking-[0.12em] text-stone">About your space
            <textarea id="book-message" name="message" rows="3" placeholder="3BHK in Whitefield, possession in June, need kitchen + wardrobes…" class="text-base font-medium bg-white border border-ink/10 rounded-xl px-4 py-3.5 outline-none focus:border-bronze resize-none placeholder:text-ink/30"></textarea>
          </label>
          <button type="submit" data-whatsapp={SITE.whatsapp} class="bg-graphite text-chalk text-[12px] font-bold uppercase tracking-[0.14em] py-4.5 py-4 rounded-xl hover:bg-aubergine active:bg-aubergine transition-colors">Request callback → via WhatsApp</button>
          <p class="text-xs text-stone text-center leading-relaxed">Submitting opens WhatsApp with your details pre-filled — press send there to complete the request. We reply within 4 working hours.</p>
        </form>
        <div id="book-success" class="hidden mt-4 bg-moss/10 border border-moss/25 text-moss font-bold text-sm rounded-xl px-4 py-3">✓ Request ready — WhatsApp opened. Prefer email? Write to {SITE.email}.</div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function(){
    try {
      const pal = localStorage.getItem('vjs-palette');
      const note = document.getElementById('book-palette-note');
      const msg = document.getElementById('book-message');
      if (pal && note) {
        note.classList.remove('hidden');
        note.textContent = '✦ Carrying palette: ' + pal;
        if (msg && !msg.value) msg.value = 'I loved the "' + pal + '" palette in Compose Your Space. ';
      }
    } catch(e) {}
  })();
</script>
