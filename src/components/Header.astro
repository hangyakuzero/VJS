---
import { NAV, SITE } from '../data/content';
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300 bg-chalk/70 backdrop-blur-xl border-b border-ink/5">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 h-[72px] flex items-center justify-between gap-4">
    <a href="#top" class="flex items-center gap-3 shrink-0 group">
      <span class="w-10 h-10 rounded-full bg-graphite text-chalk grid place-items-center font-display text-xl leading-none pt-0.5 group-hover:bg-aubergine transition-colors">V</span>
      <span class="leading-none">
        <span class="block font-display font-medium text-[19px] tracking-tight display-tight">VJS <span class="italic font-normal">Atelier</span></span>
        <span class="block text-[10px] font-bold uppercase tracking-[0.22em] text-stone mt-1 hidden min-[400px]:block">Bangalore · Est. 2007</span>
      </span>
    </a>
    <nav class="hidden lg:flex items-center gap-8 text-[13px] font-bold uppercase tracking-[0.14em] text-ink/60">
      {NAV.map((n) => (
        <a data-nav={n.href.slice(1)} href={n.href} class="hover:text-ink transition-colors relative after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-0 after:bg-bronze hover:after:w-full after:transition-all">{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href={`tel:${SITE.phoneLink}`} class="hidden xl:block text-[13px] font-bold tracking-wide text-ink/60 hover:text-ink">{SITE.phoneDisplay}</a>
      <a href="#book" class="bg-graphite text-chalk text-[13px] font-bold uppercase tracking-[0.12em] px-5 sm:px-6 py-3 rounded-full hover:bg-aubergine active:bg-aubergine transition-colors whitespace-nowrap"><span class="sm:hidden">Enquire</span><span class="hidden sm:inline">Discuss project →</span></a>
      <button id="menu-btn" aria-label="Open menu" class="lg:hidden w-10 h-10 grid place-items-center rounded-full border border-ink/10">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="hidden fixed inset-0 z-[80] bg-graphite text-chalk overflow-y-auto">
  <div class="p-5 flex items-center justify-between">
    <span class="font-display text-2xl">VJS <span class="italic">Atelier</span></span>
    <button id="menu-close" aria-label="Close menu" class="w-10 h-10 grid place-items-center rounded-full border border-chalk/20 text-xl">×</button>
  </div>
  <nav class="px-8 pt-6 flex flex-col gap-5 text-2xl font-display">
    {NAV.map((n) => (
      <a href={n.href} class="border-b border-chalk/10 pb-4">{n.label}</a>
    ))}
    <a href="#book" class="mt-4 bg-chalk text-ink text-center font-body font-bold text-base px-6 py-4 rounded-full">Discuss project</a>
    <p class="font-body text-sm text-chalk/60">{SITE.phoneDisplay} · {SITE.city}</p>
  </nav>
</div>

<style>
  #site-header.is-scrolled { background: rgba(251,250,247,0.9); box-shadow: 0 12px 40px rgba(22,19,15,0.08); }
</style>
