---
import SectionHeading from './SectionHeading.astro';
---

<section id="studies" class="py-20 md:py-32 bg-chalk scroll-mt-20">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <SectionHeading eyebrow="Design studies — Bangalore" title="Rooms with reasoning behind them." desc="Every study starts with a brief — light, routine, ritual — then resolves into palette, plan and detail. Concept visuals shown; real photography replaces them at launch." />
      <div class="flex p-1 rounded-full bg-ink/5 border border-ink/10 w-fit" role="tablist" aria-label="Filter studies" data-reveal>
        <button data-filter="all" class="px-5 py-2.5 rounded-full text-[12px] font-bold uppercase tracking-[0.12em] bg-graphite text-chalk">All</button>
        <button data-filter="living" class="px-5 py-2.5 rounded-full text-[12px] font-bold uppercase tracking-[0.12em] text-ink/60 hover:text-ink">Living</button>
        <button data-filter="working" class="px-5 py-2.5 rounded-full text-[12px] font-bold uppercase tracking-[0.12em] text-ink/60 hover:text-ink">Working</button>
      </div>
    </div>

    <div id="studies-grid" class="mt-10 grid md:grid-cols-12 gap-5">
      <!-- 1 large -->
      <figure data-kind="living" class="study-card group relative rounded-[28px] overflow-hidden md:col-span-7 aspect-[16/10] md:aspect-auto md:min-h-[520px] bg-graphite" data-reveal>
        <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?q=80&w=1600&auto=format&fit=crop" alt="Warm minimal 3BHK living space" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] group-hover:scale-[1.04]" />
        <div class="absolute inset-0 bg-gradient-to-t from-graphite/90 via-graphite/15 to-transparent"></div>
        <span class="absolute top-5 left-5 text-[11px] font-bold uppercase tracking-[0.14em] bg-chalk/90 px-4 py-2 rounded-full">Living · 1,450 sq.ft</span>
        <figcaption class="absolute bottom-0 p-6 md:p-9 text-chalk max-w-xl">
          <p class="g-label text-bronze mb-2">Study 01 — Whitefield 3BHK</p>
          <p class="font-display text-2xl md:text-4xl leading-[1.02]">Morning light, walnut anchor, linen calm.</p>
          <p class="mt-3 text-chalk/65 text-sm leading-relaxed">Brief: young family, work-from-home, grandparents visiting. Solution: east-facing living kept pale, dining anchored in walnut, pooja niche carved from the passage wall.</p>
        </figcaption>
      </figure>

      <div class="md:col-span-5 flex flex-col gap-5">
        <figure data-kind="living" class="study-card group relative rounded-[28px] overflow-hidden aspect-[16/10] md:aspect-auto md:flex-1 md:min-h-[250px] bg-graphite" data-reveal>
          <img src="https://images.unsplash.com/photo-1600489000022-c2086d79f9d4?q=80&w=1200&auto=format&fit=crop" alt="Chef-grade kitchen concept" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-graphite/90 via-graphite/10 to-transparent"></div>
          <span class="absolute top-5 left-5 text-[11px] font-bold uppercase tracking-[0.14em] bg-chalk/90 px-4 py-2 rounded-full">Kitchen · Island + pantry</span>
          <figcaption class="absolute bottom-0 p-6 text-chalk">
            <p class="g-label text-bronze mb-1.5">Study 02 — HSR Kitchen</p>
            <p class="font-display text-xl md:text-2xl">Built around the cook's height.</p>
          </figcaption>
        </figure>
        <figure data-kind="working" class="study-card group relative rounded-[28px] overflow-hidden aspect-[16/10] md:aspect-auto md:flex-1 md:min-h-[250px] bg-graphite" data-reveal>
          <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=1200&auto=format&fit=crop" alt="Boutique workspace concept" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] group-hover:scale-[1.04]" />
          <div class="absolute inset-0 bg-gradient-to-t from-graphite/90 via-graphite/10 to-transparent"></div>
          <span class="absolute top-5 left-5 text-[11px] font-bold uppercase tracking-[0.14em] bg-chalk/90 px-4 py-2 rounded-full">Commercial · 900 sq.ft</span>
          <figcaption class="absolute bottom-0 p-6 text-chalk">
            <p class="g-label text-bronze mb-1.5">Study 03 — Indiranagar Studio</p>
            <p class="font-display text-xl md:text-2xl">Fluted glass, fast fit-out, photogenic.</p>
          </figcaption>
        </figure>
      </div>

      <figure data-kind="living" class="study-card group relative rounded-[28px] overflow-hidden md:col-span-5 aspect-[16/10] md:min-h-[380px] bg-graphite" data-reveal>
        <img src="https://images.unsplash.com/photo-1616594039964-ae9021a400a0?q=80&w=1200&auto=format&fit=crop" alt="Wardrobe wall concept" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1.2s] group-hover:scale-[1.04]" />
        <div class="absolute inset-0 bg-gradient-to-t from-graphite/90 via-graphite/10 to-transparent"></div>
        <span class="absolute top-5 left-5 text-[11px] font-bold uppercase tracking-[0.14em] bg-chalk/90 px-4 py-2 rounded-full">Storage · His + hers</span>
        <figcaption class="absolute bottom-0 p-6 md:p-8 text-chalk">
          <p class="g-label text-bronze mb-1.5">Study 04 — JP Nagar Wardrobes</p>
          <p class="font-display text-xl md:text-[28px] leading-tight">Floor-to-ceiling, zero dust traps.</p>
          <p class="mt-2 text-chalk/65 text-sm">Laser-measured, loft ladders you can actually reach.</p>
        </figcaption>
      </figure>

      <a href="#book" data-kind="working" class="study-card group rounded-[28px] md:col-span-7 bg-aubergine text-chalk p-8 md:p-12 flex flex-col justify-between min-h-[280px] md:min-h-[380px] overflow-hidden relative" data-reveal>
        <div class="absolute -top-24 -right-24 w-[380px] h-[380px] rounded-full bg-bronze/20 blur-[100px]"></div>
        <div class="relative">
          <p class="g-label text-bronze">Your project — Study 05</p>
          <p class="font-display text-3xl md:text-5xl leading-[1.02] mt-4 max-w-md">Bring us the plan. We'll bring the point of view.</p>
        </div>
        <div class="relative mt-8 flex flex-wrap items-center gap-4">
          <span class="bg-chalk text-graphite font-bold text-[12px] uppercase tracking-[0.12em] px-7 py-4 rounded-full group-hover:bg-bronze group-hover:text-chalk transition-colors">Start with a site visit →</span>
          <span class="text-chalk/50 text-sm">Free measurement · fixed quote in 48h</span>
        </div>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (function(){
    const btns = Array.from(document.querySelectorAll('[data-filter]'));
    const cards = Array.from(document.querySelectorAll('.study-card'));
    if(!btns.length) return;
    btns.forEach((b) => b.addEventListener('click', () => {
      const f = b.getAttribute('data-filter');
      btns.forEach((x) => {
        const on = x === b;
        x.className = 'px-5 py-2.5 rounded-full text-[12px] font-bold uppercase tracking-[0.12em] ' + (on ? 'bg-graphite text-chalk' : 'text-ink/60 hover:text-ink');
      });
      cards.forEach((c) => {
        const k = c.getAttribute('data-kind');
        const show = f === 'all' || k === f || k === null;
        c.style.display = show ? '' : 'none';
      });
    }));
  })();
</script>
