---
import { SITE } from '../data/content';
---

<footer class="bg-graphite text-chalk">
  <div class="max-w-[1400px] mx-auto px-5 md:px-10 py-14 grid md:grid-cols-4 gap-10">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="w-10 h-10 rounded-full bg-chalk text-graphite grid place-items-center font-display text-xl">V</span>
        <span class="font-display text-xl">VJS <span class="italic">Atelier</span></span>
      </div>
      <p class="text-chalk/55 text-sm leading-relaxed">Bangalore design atelier backed by its own factory. Homes, kitchens, wardrobes & workspaces — composed, built and installed by one team.</p>
      <p class="mt-4 text-[11px] font-bold uppercase tracking-[0.18em] text-bronze">Concept visuals · photography at launch</p>
    </div>
    <div>
      <h4 class="text-[11px] uppercase tracking-[0.18em] text-chalk/40 mb-4 font-bold">Explore</h4>
      <ul class="space-y-2.5 text-sm font-semibold">
        <li><a href="#studies" class="hover:text-bronze">Design studies</a></li>
        <li><a href="#atelier" class="hover:text-bronze">Compose your space</a></li>
        <li><a href="#services" class="hover:text-bronze">Crafts</a></li>
        <li><a href="#about" class="hover:text-bronze">The studio</a></li>
        <li><a href="#testimonials" class="hover:text-bronze">Word of mouth</a></li>
        <li><a href="#faqs" class="hover:text-bronze">FAQs</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-[11px] uppercase tracking-[0.18em] text-chalk/40 mb-4 font-bold">Crafts</h4>
      <ul class="space-y-2.5 text-sm text-chalk/70">
        <li>Full home interiors</li>
        <li>Modular kitchens</li>
        <li>Wardrobes & storage</li>
        <li>Offices · retail · clinics</li>
      </ul>
    </div>
    <div>
      <h4 class="text-[11px] uppercase tracking-[0.18em] text-chalk/40 mb-4 font-bold">Visit / Call</h4>
      <p class="text-sm text-chalk/70 leading-relaxed">{SITE.address}<br />{SITE.hours}<br />{SITE.phoneDisplay}<br />{SITE.email}</p>
      <a href="#book" class="inline-block mt-4 bg-chalk text-graphite text-[12px] font-bold uppercase tracking-[0.12em] px-5 py-3 rounded-full hover:bg-bronze hover:text-chalk transition-colors">Discuss project</a>
    </div>
  </div>
  <div class="border-t border-chalk/10">
    <div class="max-w-[1400px] mx-auto px-5 md:px-10 py-5 flex flex-col md:flex-row gap-2 items-center justify-between text-xs text-chalk/40">
      <span>© 2026 VJS Studios · Bangalore, India. All rights reserved.</span>
      <span>Design-led · Factory-backed · 10-year warranty</span>
    </div>
  </div>
</footer>
