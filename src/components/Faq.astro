---
import SectionHeading from './SectionHeading.astro';
import { FAQS } from '../data/content';
---

<section id="faqs" class="py-20 md:py-32 bg-paper/60 border-t border-ink/8 scroll-mt-20">
  <div class="max-w-4xl mx-auto px-5 md:px-8">
    <SectionHeading align="center" eyebrow="Good questions" title="Everything Bangalore asks us." desc="Costs, timelines, warranty, factory visits — answered honestly. Still unsure? Ask us on WhatsApp." />
    <div class="mt-10 flex flex-col gap-3">
      {FAQS.map((f, i) => (
        <div data-faq data-reveal class="bg-white border border-ink/8 rounded-2xl overflow-hidden">
          <button data-faq-btn class="w-full flex items-center justify-between gap-4 text-left p-5 md:p-6">
            <span class="font-bold text-[15px] md:text-base"><span class="text-wood mr-2">0{i + 1}.</span>{f.q}</span>
            <span data-faq-icon class="shrink-0 w-8 h-8 rounded-full bg-sand grid place-items-center text-lg transition-transform duration-300">+</span>
          </button>
          <div data-faq-panel style="max-height: 0px; overflow: hidden; transition: max-height 0.4s ease;">
            <p class="px-5 md:px-6 pb-6 text-smoke leading-relaxed text-[15px]">{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
